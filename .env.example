# Solo hace falta para ejecutarlo en tu ordenador. En Vercel no tienes que tocar nada:
# la integración de Neon crea DATABASE_URL sola y lo demás se configura dentro de la app.
# Copia este archivo a .env.local. Nunca subas .env.local al repositorio.

# Única variable obligatoria: la base de datos Postgres (Neon u otra).
DATABASE_URL=postgres://postgres@localhost:5432/dashboard

# --- Opcionales (para usuarios avanzados) ----------------------------------
# Todo esto se puede dejar vacío. Si rellenas algo, manda sobre lo de Ajustes.

# Secreto propio para firmar la sesión (32+ caracteres). Sin él se deriva de DATABASE_URL.
# AUTH_SECRET=
# Contraseña fijada por variable (hash de: npm run hash-password -- "contraseña").
# AUTH_PASSWORD_HASH=
# Protege /api/cron/sync. Sin él, la ruta se puede llamar como mucho cada 15 minutos.
# CRON_SECRET=
# Enlaces de calendario (normalmente se pegan en Ajustes).
# MOODLE_ICAL_URL=
# MOODLE_TOKEN=
# MOODLE_URL=
# OUTLOOK_ICS_URL=
